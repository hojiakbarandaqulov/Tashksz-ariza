# Ushbu faylni serverda /etc/toshksz-bot/toshksz-bot.env nomi bilan saqlang.
# Haqiqiy token va parolni Git yoki chatga yubormang.
TELEGRAM_BOT_USERNAME=ToshKSZArizaQabul2026Bot
TELEGRAM_BOT_TOKEN=BotFather_bergan_YANGI_token
TELEGRAM_ADMIN_ID=0
TELEGRAM_AUTO_CREATE_ADMIN=true
TELEGRAM_BOT_ENABLED=true

# JAR va PostgreSQL bir serverda bo'lsa 127.0.0.1 to'g'ri va xavfsiz manzil.
DB_URL=jdbc:postgresql://127.0.0.1:5432/Tashksz-bot-db
DB_USERNAME=toshksz_bot
DB_PASSWORD=KUCHLI_YANGI_PAROL

# Bot HTTP server ochmaydi; Telegram bilan long polling orqali ishlaydi.
SPRING_MAIN_WEB_APPLICATION_TYPE=none
